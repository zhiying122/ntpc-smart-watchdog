# ==========================================================
# 環境變數範本 (Environment Variables Template)
# ==========================================================
# 用法：
#   1. 複製這個檔案並改名為 .env
#      指令： copy .env.example .env
#   2. 把下面的值換成你自己的真實金鑰
#   3. .env 已被 .gitignore 擋住，不會被上傳到 GitHub
#
# 注意：這個 .env.example 檔案「不含真實金鑰」，可以安全上傳，
#       是給隊友看要設定哪些變數用的。真實金鑰只能放在 .env。
# ==========================================================

# ---------- AWS 憑證 ----------
# 競賽環境（AWS Workshop Studio）發的是「臨時憑證」，一定會多一個
# AWS_SESSION_TOKEN，三個都要填。憑證來源：Workshop Studio 側欄
# 「Get AWS CLI credentials」→ 複製 Access Key / Secret / Session Token。
# 可用 Region：us-west-2、us-east-1（Bedrock Claude 建議用 us-west-2）。
# 注意：若在 EC2 上以 IAM Role（instance profile）執行，則不需填以下金鑰，
#       boto3 會自動從 instance metadata 取得不會過期的臨時憑證。
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_SESSION_TOKEN=your_session_token_here
AWS_DEFAULT_REGION=us-west-2

# ---------- AWS Bedrock（生成式 AI 基礎模型）----------
# 此競賽環境的 Claude 模型只支援 inference profile，需加 us. 前綴。
# 模型需先在 Bedrock console「Model access」開通後才可呼叫。
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_REGION=us-west-2

# ---------- AWS S3（資料儲存）----------
S3_BUCKET_NAME=ntpc-watchdog-data

# ---------- 資料庫（如果有用到）----------
DATABASE_URL=sqlite:///data/watchdog.db
DB_PASSWORD=your_db_password_here

# ---------- 其他 API（如果有用到）----------
# 例如爬蟲要用的 API Token
API_TOKEN=your_api_token_here
