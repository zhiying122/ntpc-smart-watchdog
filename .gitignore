# ==========================================================
# 機密憑證 - 絕對不能上傳到 GitHub！
# ==========================================================
# 環境變數檔（AWS 金鑰、API Token、資料庫密碼放這裡）
.env
.env.*
!.env.example
*.env

# AWS 憑證
.aws/
aws.json
credentials
*credentials*
*.pem
*.key
*_accessKeys.csv
*accessKeys*

# 各種金鑰與 Token
*.secret
secrets.*
*api_key*
*apikey*
*token*
config.local.*

# ==========================================================
# Python
# ==========================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虛擬環境
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Jupyter Notebook
.ipynb_checkpoints

# ==========================================================
# Node.js / 前端（如果之後做 Web 儀表板）
# ==========================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
.next/
.nuxt/
.cache/
build/

# ==========================================================
# 資料集（原始檔太大，且可能含個資，不上傳）
# ==========================================================
# 比賽提供的原始資料集資料夾
E_教育局-資料集/
E_教育局-命題文件/
data/raw/*
data/interim/
*.pdf
!docs/**/*.pdf
# 例外：司法／行政處分結構化樣本（公開判決摘要之整理，無個資）。
# EC2 部署需此檔供司法事實層查詢，故納入版控（原始個資檔仍由 data/raw/* 排除）。
!data/raw/judicial_records.json

# OCR / 拆頁工具的產出（含財報數字、可能個資，絕不上傳）
data/derived/
*.txt
!requirements.txt
!docs/**/*.txt

# Tesseract 語言包（大檔，可重新下載，不進版控）
data/tessdata/

# 產生的中間檔（可重新產生，不需版控）
data/processed/*.csv
data/processed/*.parquet
data/processed/*.json

# 例外：線上部署所需的「契約檔／衍生資料」（皆為公開財務決算之彙整衍生，
# 無個資、無敏感資訊）。EC2 clone 後需要這些檔案才能啟動，故明確納入版控。
# 這些是公開資料的衍生成果，非原始個資檔（原始 PDF/OCR 仍由上方規則排除）。
!data/processed/kindergartens_latest.csv
!data/processed/kindergartens.csv
!data/processed/kindergartens_roster.csv
!data/processed/nonprofit_financials_bedrock.csv
!data/processed/geocoded.csv
# 輿情負面度（新聞 RSS + PTT 公開看板之衍生；僅標題/連結/負面比例，無個資）。
# EC2 部署需此檔才能讓輿情分項計入總分，故納入版控。
!data/processed/sentiment.csv

# 動態資料連接器的本地快取（由官方開放資料即時抓取，可重新產生，不進版控）
data/cache/
*.sqlite
*.db

# 定時資料快照（由 GitHub Actions 每日自動抓取並 commit，需進版控供線上部署讀取）
# 明確保留：這些是公開開放資料（無個資、無風險欄位），是線上網站的最新備援。
!data/snapshots/
!data/snapshots/*.json

# ==========================================================
# 開發工具與系統檔
# ==========================================================
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# 記錄檔
*.log
logs/

# 測試與覆蓋率
.pytest_cache/
.coverage
htmlcov/
.tox/
# Hypothesis 屬性測試快取資料庫（可重新產生，不進版控）
.hypothesis/

# Tesseract 語言包（放專案根 tessdata/，檔案大不進版控；用 scripts 還原）
/tessdata/
